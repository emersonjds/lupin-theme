  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5B758A"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#5B758A"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#34D399"
      }
    },
    {
      "name": "Python docstring",
      "scope": [
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#5B758A"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#FDA77F"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#FDA77F"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Symbol and key",
      "scope": [
        "constant.other.symbol",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#4FF8D2"
      }
    },
    {
      "name": "Self and this",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#B98CCD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#E7E8E8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constant variable",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#4FF8D2"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable"
      ],
      "settings": {
        "foreground": "#E7E8E8"
      }
    },
    {
      "name": "Property",
      "scope": [
        "support.variable.property",
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Control keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Expression keyword",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#818C96"
      }
    },
    {
      "name": "Storage and modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B98CCD"
      }
    },
    {
      "name": "Primitive type",
      "scope": [
        "storage.type.primitive",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#E0CA3C"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#E0CA3C"
      }
    },
    {
      "name": "Class name",
      "scope": [
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#E0CA3C"
      }
    },
    {
      "name": "Type parameter",
      "scope": [
        "entity.name.type.type-parameter",
        "meta.indexer.mappedtype.declaration"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call.object",
        "support.function"
      ],
      "settings": {
        "foreground": "#4FF8D2"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator variable.other.readwrite",
        "meta.decorator variable.other.object"
      ],
      "settings": {
        "foreground": "#7DD3FC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#E7E8E8"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#B98CCD"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#B98CCD"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7DD3FC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#818C96"
      }
    },
    {
      "name": "String quotes",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#34D399"
      }
    },
    {
      "name": "Interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Keyword punctuation",
      "scope": [
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#34D399"
      }
    },
    {
      "name": "Regexp punctuation",
      "scope": [
        "punctuation.definition.string.begin.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "#34D399"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF6663",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#5B758A",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#4FF8D2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "foreground": "#E7E8E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "foreground": "#E7E8E8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw",
        "fenced_code.block.language",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#34D399"
      }
    },
    {
